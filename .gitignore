# Credenciais e configuração local — NUNCA versionar
.env
*.key
*.pem

# Certificados gerados localmente (cada um gera os seus com certs/gerar_certificados.py)
certs/*.crt
certs/*.srl
certs/*.csr
certs/falsos/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editores / sistema
.vscode/
.idea/
Thumbs.db
.DS_Store

# LaTeX (arquivos temporários da compilação do relatório)
docs/relatorio/*.aux
docs/relatorio/*.log
docs/relatorio/*.out
docs/relatorio/*.toc
docs/relatorio/*.fls
docs/relatorio/*.fdb_latexmk
docs/relatorio/*.synctex.gz
